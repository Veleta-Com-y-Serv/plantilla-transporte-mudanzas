---
// Preguntas frecuentes: banda clara; en escritorio, titular fijo a la izquierda y acordeón nativo <details> a la derecha
// (filas separadas por líneas, signo en placa amarilla), sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta).
// Sin preguntas no se pinta. También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={Astro.props.id} class="seccion">
      <div class="contenedor faq-rejilla">
        <div class="faq-cabeza">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        </div>
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true"><span>+</span></span>
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-rejilla { display: grid; }
  .faq-lista { border-top: 3px solid var(--c-texto); }
  .faq { border-bottom: 1px solid var(--linea); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 1.35rem 0; min-height: 3.5rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-pregunta { font-weight: 800; font-size: 1.15rem; line-height: 1.35; }
  .faq summary:hover .faq-pregunta { text-decoration: underline; text-decoration-color: var(--c-primario); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .faq-signo { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.5rem; background: var(--c-primario); color: var(--sobre-primario); font-size: 1.6rem; font-weight: 900; transform: skewX(-10deg); }
  .faq-signo span { display: block; transition: transform .2s ease; }
  .faq[open] .faq-signo { background: var(--c-texto); color: var(--c-fondo); }
  .faq[open] .faq-signo span { transform: rotate(45deg); }
  .faq-respuesta { padding: 0 3.5rem 1.6rem 0; opacity: .85; max-width: 52rem; }
  @media (min-width: 1024px) {
    .faq-rejilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 5rem; align-items: start; }
    .faq-cabeza { position: sticky; top: calc(var(--alto-cabecera) + 2rem); }
    .faq-pregunta { font-size: 1.25rem; }
  }
</style>
