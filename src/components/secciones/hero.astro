---
// Hero partido a sangre: a la izquierda, panel marino con antetítulo, título enorme en cursiva, línea de carretera,
// `texto` y dos botones (`cta` para llamar, `cta_secundario` para el presupuesto); a la derecha, la foto del camión
// a sangre hasta el borde de la ventana, con el borde izquierdo en sesgo y el `destacado` en una placa amarilla.
// Debajo, a todo el ancho, la «barra de ruta» amarilla: formulario corto (origen, destino, fecha, teléfono) que abre
// el correo. Opcionales: `formulario_titulo` (si falta, el texto de `cta_secundario`) y `boton_formulario`.
// Sin foto, el panel ocupa todo el ancho.
import { seccion } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const tituloForm = (s?.formulario_titulo as string) || s?.cta_secundario?.texto || '';
const botonForm = (s?.boton_formulario as string) || 'Enviar';
const esTel = (u?: string) => Boolean(u && u.startsWith('tel:'));
---

{
  s && (
    <section id={id} class="hero-ruta banda-oscura">
      <div class:list={['hero-partido', { 'hero-partido--sin-foto': !s.imagen }]}>
        <div class="hero-texto">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h1 class="hero-titulo">{s.titulo}</h1>}
          <div class="linea-vial hero-linea" aria-hidden="true" />
          {s.texto && <p class="hero-parrafo">{s.texto}</p>}
          {(s.cta || s.cta_secundario) && (
            <div class="hero-botones">
              {s.cta && (
                <a class="btn" href={s.cta.url}>
                  {esTel(s.cta.url) && <Icono nombre="telefono" tam={20} />}
                  {s.cta.texto}
                </a>
              )}
              {s.cta_secundario && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
            </div>
          )}
          {!s.imagen && s.destacado && (
            <p class="placa hero-placa-sola">
              <span>{[s.destacado.titulo, s.destacado.texto].filter(Boolean).join(' · ')}</span>
            </p>
          )}
        </div>
        {s.imagen && (
          <div class="hero-foto sesgo-izq">
            <Imagen src={s.imagen} alt={altHero()} ancho={1600} alto={1200} prioridad={primera} />
            {s.destacado && (
              <div class="hero-destacado">
                <span class="hero-destacado-icono"><Icono nombre="escudo" tam={26} /></span>
                <div>
                  {s.destacado.titulo && <p class="hero-destacado-titulo">{s.destacado.titulo}</p>}
                  {s.destacado.texto && <p class="hero-destacado-texto">{s.destacado.texto}</p>}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
      <div class="hero-barra banda-primaria">
        <div class="hero-barra-dentro">
          {tituloForm && <p class="hero-barra-titulo">{tituloForm}</p>}
          <FormularioContacto modelo="ruta" prefijo={`${id}-f`} boton={botonForm} />
        </div>
      </div>
    </section>
  )
}

<style>
  .hero-partido { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero-texto { padding: 3rem 1rem 3.5rem; display: flex; flex-direction: column; justify-content: center; }
  .hero-titulo { margin-top: 1.25rem; font-size: clamp(2.6rem, 10.5vw, 5rem); overflow-wrap: break-word; }
  .hero-linea { width: min(16rem, 70%); margin-top: 1.75rem; }
  .hero-parrafo { margin-top: 1.5rem; max-width: 36rem; font-size: 1.125rem; opacity: .9; }
  .hero-botones { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .85rem 1rem; }
  .hero-placa-sola { margin-top: 2rem; align-self: flex-start; }
  .hero-foto { position: relative; aspect-ratio: 4 / 3; background: var(--marino-hondo); }
  .hero-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-destacado { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; display: flex; gap: .85rem; align-items: center; padding: .8rem 1rem; background: var(--c-primario); color: var(--sobre-primario); }
  .hero-destacado-icono { display: grid; place-items: center; flex-shrink: 0; }
  .hero-destacado-titulo { font-weight: 900; font-style: italic; text-transform: uppercase; line-height: 1.15; }
  .hero-destacado-texto { font-size: .9rem; line-height: 1.35; }

  .hero-barra-dentro { padding: 1.75rem 1rem 1.5rem; }
  .hero-barra-titulo { font-family: var(--fuente-titulos); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: clamp(1.5rem, 5vw, 2rem); line-height: 1; margin-bottom: 1rem; }

  @media (max-width: 1023px) { .hero-foto { clip-path: none; } }
  @media (min-width: 768px) {
    .hero-texto { padding: 4.5rem var(--lateral) 4.5rem; }
    .hero-titulo { font-size: clamp(3.5rem, 8.6vw, 6rem); }
    .hero-foto { aspect-ratio: 16 / 9; }
    .hero-destacado { left: auto; right: var(--lateral); max-width: 24rem; bottom: 1.5rem; }
    .hero-barra-dentro { padding: 2rem var(--lateral) 1.75rem; }
  }
  @media (min-width: 1024px) {
    .hero-partido { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); min-height: max(32rem, calc(100svh - var(--alto-cabecera) - 9.5rem)); }
    .hero-partido--sin-foto { grid-template-columns: minmax(0, 1fr); }
    .hero-texto { padding: 5rem 3.5rem 5rem var(--lateral); }
    .hero-titulo { font-size: clamp(3.5rem, 5.6vw, 6.75rem); }
    .hero-partido--sin-foto .hero-titulo { font-size: clamp(4rem, 7.5vw, 7.5rem); max-width: 18ch; }
    .hero-foto { aspect-ratio: auto; min-height: 32rem; }
    .hero-destacado { bottom: 2rem; }
    .hero-barra-dentro { display: grid; grid-template-columns: 15rem 1fr; gap: 2.5rem; align-items: start; }
    .hero-barra-titulo { margin: 1.4rem 0 0; }
  }
</style>
