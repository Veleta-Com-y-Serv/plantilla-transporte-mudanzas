---
// Titular de sección (antetítulo con raya amarilla + título enorme en cursiva + texto). Adaptado de AstroWind (Headline.astro), © onWidget, MIT.
// `alinear="partido"`: en escritorio, título a la izquierda y texto a la derecha a todo el ancho del contenido.
interface Props { titulo?: string; antetitulo?: string; texto?: string; alinear?: 'izquierda' | 'centro' | 'partido'; class?: string; nivel?: 1 | 2 }
const { titulo, antetitulo, texto, alinear = 'izquierda', class: clase = '', nivel = 2 } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={['titular', { 'titular--centro': alinear === 'centro', 'titular--partido': alinear === 'partido' }, clase]}>
      <div>
        {antetitulo && <p class="antetitulo">{antetitulo}</p>}
        {titulo && <H class="titulo-seccion">{titulo}</H>}
      </div>
      {texto && <p class="titular-texto">{texto}</p>}
    </div>
  )
}
