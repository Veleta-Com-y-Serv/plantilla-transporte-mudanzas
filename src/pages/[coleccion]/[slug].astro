---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «ruta»: banda marina con migas, placa amarilla en sesgo, título en cursiva y la foto con borde en sesgo (sin
// foto, el icono grande en placa amarilla); banda clara con el `detalle` y, al lado, la tabla de datos y la caja
// amarilla de presupuesto; franja de fotos (`imagenes`) a sangre; y otros servicios de la lista en celdas con líneas finas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? '/#presupuesto' : site.boton_cabecera?.url || '/#contacto';
const textoPresupuesto = site.boton_cabecera?.texto || 'Pide presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 4);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-oscura ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="placa"><span>{f.categoria || f.def.nombre}</span></p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span><Icono nombre={f.icono || 'camion'} tam={72} /></span></div>
        )}
      </div>
    </div>
  </section>
  <div class="linea-vial" aria-hidden="true"></div>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda-primaria">
          <p class="ficha-cita-titulo">¿Cuándo es tu mudanza?</p>
          <p>Cuéntanos de dónde a dónde y te damos el precio cerrado por escrito.</p>
          <a class="btn btn--marino" href={presupuesto}>{textoPresupuesto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria" style={`--n:${Math.min(f.imagenes.length, 3)}`}>
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={800} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion banda-gris">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'camion'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: 1rem clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .migas li { display: inline-flex; align-items: center; gap: .6rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-primario); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { color: var(--c-primario); }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: 1rem; align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.1rem, 8vw, 4.25rem); overflow-wrap: anywhere; }
  .ficha-precio { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-weight: 900; font-style: italic; font-size: 1.5rem; color: var(--c-primario); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--superficie); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 16 / 9; border: 3px solid var(--c-primario); }
  .ficha-icono span { display: inline-grid; place-items: center; width: 9rem; height: 7rem; background: var(--c-primario); color: var(--sobre-primario); transform: skewX(-10deg); }
  .ficha-icono span :global(svg) { transform: skewX(10deg); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; margin-bottom: 1rem; text-transform: uppercase; font-style: italic; }
  .ficha-datos { border: 3px solid var(--c-texto); padding: 1.5rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 800; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 900; font-style: italic; text-transform: uppercase; line-height: 1.1; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; justify-self: start; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 900; font-style: italic; text-decoration: none; }
  .ficha-galeria { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ficha-galeria li { aspect-ratio: 1 / 1; overflow: hidden; }
  .ficha-galeria li:only-child { grid-column: 1 / -1; aspect-ratio: 16 / 7; }
  .ficha-otras { display: grid; border-top: 1px solid var(--linea); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem 0 2rem; border-bottom: 1px solid var(--linea); transition: background-color .2s ease, color .2s ease; }
  .ficha-otra-icono { display: inline-grid; place-items: center; align-self: flex-start; width: 3.25rem; height: 2.9rem; background: var(--c-primario); color: var(--sobre-primario); transform: skewX(-10deg); }
  .ficha-otra-icono :global(svg) { transform: skewX(10deg); }
  .ficha-otra h3 { font-size: 1.25rem; margin-top: .5rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-texto); outline-offset: -3px; }
  .ficha-otra-texto { opacity: .78; font-size: .98rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; margin-top: auto; padding-top: .5rem; font-weight: 900; font-style: italic; text-transform: uppercase; font-size: .85rem; }
  @media (min-width: 640px) {
    .ficha-otras { grid-template-columns: repeat(2, minmax(0, 1fr)); border-left: 1px solid var(--linea); }
    .ficha-otra { padding: 2rem 1.75rem 2.25rem; border-right: 1px solid var(--linea); }
  }
  @media (min-width: 768px) {
    .ficha-galeria { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .ficha-galeria li:only-child { aspect-ratio: 16 / 6; }
  }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-foto { clip-path: polygon(var(--sesgo) 0, 100% 0, 100% 100%, 0 100%); }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
  @media (min-width: 1100px) { .ficha-otras { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (hover: hover) {
    .ficha-otra:hover { background: var(--c-texto); color: var(--c-fondo); }
    .ficha-otra:hover .ficha-otra-ver { color: var(--c-primario); }
  }
</style>
