---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda-oscura error-404">
    <div class="contenedor seccion">
      <p class="antetitulo">Error 404</p>
      <p class="error-numero" aria-hidden="true">404</p>
      <div class="linea-vial mt-4 max-w-md" aria-hidden="true"></div>
      <h1 class="titulo-seccion mt-10">Esta dirección no lleva a ninguna parte</h1>
      <p class="mt-5 max-w-xl text-lg opacity-85">Puede que el enlace esté mal o que la página se haya movido. Volvemos a la ruta principal.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>

<style>
  .error-404 { min-height: calc(85svh - var(--alto-cabecera)); display: flex; align-items: center; }
  .error-404 > .contenedor { width: 100%; }
  .error-numero { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-weight: 900; font-style: italic; font-size: clamp(6rem, 32vw, 16rem); line-height: .85; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 3px var(--c-primario); }
</style>
